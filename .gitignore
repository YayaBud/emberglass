# Publish only the Godot game and the Blender generator code.
/*
!/.gitignore
!/README.md
!/game/
!/scripts/

# game: editor caches, build output, screenshots
/game/.godot/
/game/.mono/
/game/bin/
/game/obj/
/game/*.user
/game/*.png
/game/*.png.import
/game/*.jpg
/game/*.log

# scripts: render outputs and Blender files are regenerated by the scripts
/scripts/**/*.png
/scripts/**/*.jpg
/scripts/**/*.blend
/scripts/**/*.blend1
/scripts/**/*.mp4
/scripts/gen_atlas.py
__pycache__/
*.pyc
