<?xml version="1.0" encoding="utf-8"?>
<!-- The Godot.NET.Sdk / GodotSharp packages ship inside the Godot install rather
     than on nuget.org, so the bundled folder is added as a source. nuget.org is
     deliberately NOT cleared: the net8.0 targeting pack still restores from it,
     which matters because this machine has only a .NET 10 RC SDK. -->
<configuration>
  <packageSources>
    <add key="godot-bundled" value="D:\tools\Godot_v4.6.3-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
